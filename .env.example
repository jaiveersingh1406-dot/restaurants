# Supabase (PostgreSQL) - replaces MySQL
# Supabase Dashboard -> Project Settings -> Database -> Connection string
DATABASE_URL=postgresql://postgres.yourapp:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# JWT auth
# Generate a strong random value in production: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_this_with_a_random_secret

# Cloudinary image upload
# Get keys at https://cloudinary.com -> Dashboard -> Settings -> API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=platia

# Razorpay payment
# Get test keys at https://dashboard.razorpay.com -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret